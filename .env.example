# Copy to .env (gitignored) and fill in. Names only here; never commit values.

# --- printer (Creality OS LAN). If blank, the IP saved in Creality Print's deviceInfo.json is used.
PRINTER_IP=
PRINTER_HTTP_PORT=80
PRINTER_WS_PORT=9999
# where uploaded gcode lives on the printer (K1-style default; confirm on your CR-10 SE)
PRINTER_GCODE_ROOT=/usr/data/printer_data/gcodes
BED_USABLE_MM=215
# move limits for the gated `printer move`
BED_X_MM=220
BED_Y_MM=220
MAX_Z_MM=250
PRINTER_FILES_WAIT_S=4

# --- Creality Print (auto-detected on Windows; set on Linux/macOS or if detection fails)
#   Linux example: CREALITY_PRINT_EXE=/home/you/Applications/CrealityPrint.AppImage
#                  CREALITY_DATA_DIR=/home/you/.config/Creality/Creality Print/7.0
CREALITY_PRINT_EXE=
CREALITY_DATA_DIR=
# auto | underscore | dash  (auto tries underscore, falls back to dash on "Invalid option")
CREALITY_FLAG_STYLE=auto

# --- owner approval (owner says yes in chat -> `approve <id> --yes` -> automatic preflight)
PHYSICAL_ACTIONS_ENABLED=true
APPROVAL_TTL_MIN=15
# also send approval requests to Telegram
APPROVAL_TELEGRAM=false
# preflight blocks a start when the bed-check score is this many times the threshold
BEDCHECK_BLOCK_FACTOR=2.0

# --- filament moves (extrude / retract / load / unload)
# preheat follows the material: PLA 210, PETG 240, ABS 245, ASA 250, TPU 225 (default PETG)
FILAMENT_MATERIAL=PETG
# optional personal override when no --material is given (blank = material spec)
FILAMENT_PREHEAT_C=
# temperature for --purge (melts hardened filament from the tip)
FILAMENT_PURGE_C=300
# ceiling for every nozzle command; can be lowered, never raised past 300
FILAMENT_MAX_C=300
FILAMENT_TEMP_TOL_C=3
FILAMENT_SOAK_S=5
FILAMENT_HEAT_TIMEOUT_S=600
FILAMENT_SPEED_MM_S=3
FILAMENT_MAX_EXTRUDE_MM=100
FILAMENT_MAX_RETRACT_MM=100
FILAMENT_LOAD_MM=60
FILAMENT_PURGE_MM=15
FILAMENT_MAX_LOAD_MM=120
FILAMENT_UNLOAD_MM=80
FILAMENT_UNLOAD_PURGE_MM=5
FILAMENT_MAX_UNLOAD_MM=120

# --- camera (optional). A JPEG snapshot URL or MJPEG stream URL.
CAMERA_URL=
CAMERA_ENABLED=true
BED_CLEAR_DIFF_THRESHOLD=6.0

# --- malfunction watch
WATCH_INTERVAL_S=120
WATCH_DIFF_SPIKE=20
WATCH_STALL_DIFF=0.4
WATCH_STALL_MINUTES=12
WATCH_TEMP_DROP_C=15
WATCH_TEMP_RUNAWAY_C=15
WATCH_WS_WAIT_S=3
# ETA notice when this many minutes are left
ETA_NOTIFY_MIN=10
ALERT_COOLDOWN_MIN=15
AUTO_PAUSE_ON_ANOMALY=false
# urgent cooldown (heaters off, no owner yes) on thermal anomalies / printer errors
AUTO_COOLDOWN_ON_ANOMALY=false

# --- Telegram alerts (optional; both needed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS=true
# job notices (first layer, ETA, done photo) to Telegram
NOTIFY_TELEGRAM=true

# --- jobs
FILAMENT_COST_PER_KG=20
FILAMENT_LOW_G=150
# folders for `library scan`, separated by ;
LIBRARY_ROOTS=

# --- paths (optional)
PR_OUTPUT_DIR=
PR_OWNER_INBOX=
PR_STATE_DIR=
PR_STREAM_LOG_DAYS=7

# --- 2.0 farm (all optional; without printers.json / policy.json nothing changes)
# fleet config files (default: printers.json / printers.local.json in the project root)
PR_FLEET_FILE=
PR_FLEET_LOCAL_FILE=
# one IP var per fleet printer, named by `ip_env` in printers.json
PRINTER_IP_SE1=
# autonomy policy (default: policy.json; missing = owner_yes for everything)
PR_POLICY_FILE=
# reliability
PR_WS_CONNECT_RETRIES=2
PR_WS_CONNECT_TIMEOUT_S=5
PR_WS_BACKOFF_S=0.5
PR_WS_BACKOFF_CAP_S=15
PR_STATUS_RETRIES=1
PR_STREAM_STALE_S=30
# service (`serve`); keep 127.0.0.1 unless you created an owner/operator token
SERVE_HOST=127.0.0.1
SERVE_PORT=8787
SERVE_INTERVAL_S=30
SERVE_LOCAL_TRUST=viewer
# webhook alerts (comma-separated URLs; format json, slack or discord; secret signs JSON alerts)
ALERT_WEBHOOK_URLS=
ALERT_WEBHOOK_FORMAT=json
ALERT_WEBHOOK_SECRET=
# events to send (empty = all): done,failed,anomaly,approval_needed,filament_low,maintenance_due
ALERT_EVENTS=
ALERT_DEDUP_MIN=15
# farm
MAINT_BLOCK_DISPATCH=false
FARM_START_GRACE_S=90
# ML failure detector hook (an Obico-style server you run)
DETECTOR_ML_URL=
DETECTOR_ML_MODE=post
DETECTOR_ML_THRESHOLD=0.6
# optional slicer backends
ORCASLICER_EXE=
PRUSASLICER_EXE=
# hardware self-test: seconds to watch for the result
SELFTEST_VERIFY_S=45
